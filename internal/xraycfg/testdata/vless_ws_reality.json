{
  "tag": "proxy",
  "protocol": "vless",
  "settings": {
    "vnext": [
      {
        "address": "example.com",
        "port": 443,
        "users": [
          {
            "id": "uuid",
            "encryption": "none"
          }
        ]
      }
    ]
  },
  "streamSettings": {
    "network": "ws",
    "security": "reality",
    "wsSettings": {
      "path": "/vless-ws",
      "headers": {
        "Host": "example.com"
      }
    },
    "realitySettings": {
      "serverName": "example.com",
      "publicKey": "publickey",
      "shortId": "123456",
      "fingerprint": "chrome"
    }
  }
}