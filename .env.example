# ============================================================
# Скопируйте этот файл в .env и при необходимости отредактируйте.
#   cp .env.example .env
# .env в .gitignore и не попадает в репозиторий.
# ============================================================

# ============================================================
# Источник серверов
# ============================================================
# Список подписок живёт в subscriptions.txt (в папке данных, см. README)
# и правится из меню. Сам .env необязателен.
#
# SUBSCRIPTION_URL — для первого запуска меню: если subscriptions.txt
#   пуст, значение один раз переносится в него, после чего строку можно
#   удалить. Без меню (--server / --non-interactive) берётся, когда в
#   subscriptions.txt не одна подписка.
#   Формат: base64 (список ссылок), JSON (xray/vmess/sip008).
#
# VLESS_URL — легаси-вход для одного сервера: при первом запуске меню,
#   если subscriptions.txt пуст, один раз переносится в него. Без меню
#   не используется.
# ============================================================
# SUBSCRIPTION_URL=https://example.com/sub/TOKEN
# VLESS_URL=vless://UUID@host:443?type=ws&security=none&path=%2Fpath#name

# ============================================================
# 🔄 РЕЖИМ РАБОТЫ (MODE)
# ============================================================
#   proxy — HTTP+SOCKS5 прокси (по умолчанию)
#           Xray слушает 127.0.0.1:10808 (SOCKS5) и 127.0.0.1:10809 (HTTP)
#           Системный прокси включается автоматически
#
#   tun   — VPN через TUN-интерфейс xray-tun, весь трафик системы
#           идёт через VPN. Требует root/администратора.
#           Системный прокси не трогается.
#
# Третьего значения нет: маршрутизация по процессам (SPLIT) включается
# сама в режиме proxy, когда в apps.txt есть хотя бы одно имя — на
# Windows дополнительно нужны права администратора, иначе остаётся
# обычный proxy и об этом говорит уведомление на экране статуса.
#
# Режим переключается на лету клавишей "m" на экране статуса. Выбор
# сохраняется в last_server.json и при следующих запусках перекрывает MODE.
# ============================================================
MODE=proxy
# MODE=tun

# ============================================================
# 🎯 МАРШРУТИЗАЦИЯ ПО ПРОЦЕССАМ (режим proxy)
# ============================================================
# Файл apps.txt в папке данных — список имён процессов,
# чей трафик идёт через VPN (по одному в строке, "#" — комментарий).
# Заполняется клавишей "p" в меню подписок.
# Процессы из списка, которые сейчас не запущены, просто пропускаются.
# Linux: требует root и nftables, работает и для уже запущенных процессов.
# Windows: требует прав администратора (трафик идёт через TUN, процесс
#          определяет само ядро xray).
#
# PROXY_SYSTEM=false — не трогать системный прокси (браузер пойдёт
#                      напрямую), оставив VPN только процессам из apps.txt.
# По умолчанию: true
# ============================================================
# PROXY_SYSTEM=false

# ============================================================
# ⛔ KILL SWITCH (только Linux и только TUN)
# ============================================================
# KILL_SWITCH=true — заблокировать через iptables/ip6tables исходящий
#                    трафик мимо туннеля. Нужны обе программы; если
#                    kill switch не удалось включить, подключение не
#                    состоится.
# Пропускает DNS (порт 53), адреса VPN-серверов и то, что профиль шлёт
# напрямую. Держится, пока ядро перезапускается после сбоя; снимается
# при выходе, отключении и когда попытки перезапуска кончились.
# В режиме PROXY и при маршрутизации по процессам не действует.
# На Windows не поддерживается: с KILL_SWITCH=true программа не запустится.
# По умолчанию: false
# ============================================================
# KILL_SWITCH=true

# ============================================================
# Привязка подписки к устройству
# ============================================================
# HWID              - идентификатор устройства для панели.
#                     Если пусто — генерируется и хранится в файле hwid
#                     в папке данных (старый ./hwid.txt в приоритете)
# HWID_DEVICE_MODEL - имя модели в заголовке x-device-model
#                     По умолчанию: xray-runner
# ============================================================
# HWID=
# HWID_DEVICE_MODEL=xray-runner

# ============================================================
# Logging settings
# LOG_ENABLED=true          - enable/disable file logging (default: true)
# LOG_FILE=xray-runner.log  - log file path; a relative one goes to the data dir
# LOG_LEVEL=info            - debug | info | warn | error (anything else = info)
#   debug:   detailed debug info
#   info:    general operational messages (default)
#   warn:    only warnings and above
#   error:   only errors and above
# ============================================================
LOG_ENABLED=true
LOG_FILE=xray-runner.log
LOG_LEVEL=info

# ============================================================
# Xray-core internal log level
# XRAY_LOG_LEVEL=warning - none | debug | info | warning | error
#   warning:  only warnings and above (default, less noise)
#   debug:    verbose debug info (shows visited domains in log)
# ============================================================
XRAY_LOG_LEVEL=warning

# ============================================================
# Security
# ============================================================
# MASK_CREDENTIALS=true - mask UUID, pbk, sid in console output
#                         set to "false" to show in plaintext
# ALLOW_INSECURE=true   - устаревшая настройка: оставляет отключение проверки
#                         TLS-сертификата, если его просит ссылка или профиль.
#                         Ядро 26.7.28 такой конфиг отвергает — подключения
#                         не будет.
# ALLOW_INSECURE=false  - отключение проверки убирается из любого конфига,
#                         в том числе из профилей панели.
# ============================================================
MASK_CREDENTIALS=true
ALLOW_INSECURE=false

# ============================================================
# Проверка связи (health check)
# ============================================================
# HEALTH_CHECK_URL — адрес (или несколько через запятую), по которому
#   проверяется, что трафик реально ходит через VPN. Адреса пробуются по
#   порядку, проверка пройдена при первом ответе 200/204 — и в проверке
#   связи (PROXY раз в 15 с, TUN раз в 30 с), и в замере пинга.
#   По умолчанию: google/gstatic/cloudflare.
#   Менять, если дефолтные адреса недоступны: три неудачные проверки
#   подряд считаются обрывом и перезапускают живой xray.
# ============================================================
# HEALTH_CHECK_URL=https://www.google.com/generate_204
# HEALTH_CHECK_URL=https://ya.ru,https://www.cloudflare.com/cdn-cgi/trace

# ============================================================
# Замер пинга (клавиша b в меню)
# ============================================================
# Каждый замер поднимает отдельный экземпляр xray, поэтому они идут
# пачками, а не все сразу.
#
# BENCH_CONCURRENCY — сколько замеров одновременно (по умолчанию 3).
#   Больше — быстрее общий проход, но выше нагрузка и шум в цифрах.
# BENCH_TIMEOUT     — сколько ждать ответа от одного сервера (8s).
#   Формат: 5s, 1500ms, 1m.
# ============================================================
# BENCH_CONCURRENCY=3
# BENCH_TIMEOUT=8s

# ============================================================
# Цвета интерфейса (необязательно)
# ============================================================
# Переопределяют палитру меню без пересборки. Значение — ANSI-код 0–255
# или имя цвета lipgloss. Пусто = встроенное значение по умолчанию.
#   COLOR_TITLE    — заголовки экранов        (по умолчанию 6, cyan)
#   COLOR_CURSOR   — курсор ▸ и выбранная строка (6)
#   COLOR_SELECTED — текст выбранной строки    (6)
#   COLOR_OK       — успех/«установлено»       (2, green)
#   COLOR_WARN     — предупреждения/pre-release (3, yellow)
#   COLOR_ERR      — ошибки                     (1, red)
# ============================================================
# COLOR_TITLE=6
# COLOR_CURSOR=6
# COLOR_SELECTED=6
# COLOR_OK=2
# COLOR_WARN=3
# COLOR_ERR=1
