# Normalize line endings: LF in the repo, auto on checkout.
* text=auto

# Source and text files are always LF, so cross-platform diffs stay clean.
*.go   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.env  text eol=lf

# Binary assets must never be touched.
*.dat binary
*.dll binary
*.zip binary
*.exe binary
*.pdf binary
